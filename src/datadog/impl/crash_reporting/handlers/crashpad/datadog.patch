+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include "handler/datadog_pre_upload_callback.h"
+
+#include <map>
+#include <string>
+
+#include "build/build_config.h"
+#include "gtest/gtest.h"
+#include "snapshot/test/test_exception_snapshot.h"
+#include "snapshot/test/test_process_snapshot.h"
+
+namespace crashpad::test {
+namespace {
+
+/**
+ * Initializes a TestProcessSnapshot to simulate a contrived crash.
+ */
+void InitializeProcessSnapshot(TestProcessSnapshot& snapshot) {
+  // For CrashDump::pid
+  snapshot.SetProcessID(2345);
+
+  // For CrashDump::timestamp_ms; used for event 'date' values
+  timeval snapshot_time;
+  snapshot_time.tv_sec = 1750000000;
+  snapshot_time.tv_usec = 123;
+  snapshot.SetSnapshotTime(snapshot_time);
+
+  // For CrashDump::tid and CrashDump::fault_code; used for 'error.message'
+  auto exc = std::make_unique<TestExceptionSnapshot>();
+  exc->SetThreadID(111);
+#if BUILDFLAG(IS_WIN)
+  exc->SetException(static_cast<uint32_t>(EXCEPTION_ACCESS_VIOLATION));
+#else
+  exc->SetException(static_cast<uint32_t>(SIGSEGV));
+#endif
+  snapshot.SetException(std::move(exc));
+}
+
+/**
+ * Returns a set of annotation/parameter values that should result in successful
+ * crash processing in a normal scenario.
+ */
+std::map<std::string, std::string> MakeValidParams() {
+  return {
+      {"dd.client_token", "fake-client-token"},
+      {"dd.tracking_consent", "granted"},
+      {"dd.config",
+       R"({"source":"alto","sdk_version":"1973.3.1","service":"my-service","env":"production","version":"1.0.0"})"},
+      {"dd.os",
+       R"({"name":"TestOS","version":"1.0","build":"test","version_major":"1"})"},
+      {"dd.device",
+       R"({"type":"desktop","name":"TestDevice","model":"Test","brand":"Test","architecture":"arm64"})"},
+      {"dd.usr", R"({"id":"usr-123"})"},
+      {"dd.account", R"({"id":"acct-456"})"},
+      {"dd.rum.config",
+       R"({"application_id":"a991ca10-4004-4004-4004-beefbeefbeef","session_sample_rate":100})"},
+      {"dd.rum.session", "{}"},
+      {"dd.rum.attributes", "{}"},
+      {"dd.rum.last_view", "{}"},
+      {"other", "value"}};
+}
+
+/**
+ * Given a set of annotation/parameter values, counts how many of those
+ * parameters have a key matching 'dd.*'.
+ */
+size_t CountDatadogParameters(
+    const std::map<std::string, std::string>& params) {
+  size_t sum = 0;
+  for (const auto& kvp : params) {
+    if (kvp.first.find("dd.") == 0) {
+      ++sum;
+    }
+  }
+  return sum;
+}
+
+// When dd.client_token is set, dd.tracking_consent is granted, and all required
+// CrashContext data is present in parseable annotation values, the callback
+// should return true, include both dd.rum.view and dd.rum.error in the uploaded
+// annotations, strip all other 'dd.*' annotations, and leave any other
+// annoations alone
+TEST(DatadogPreUploadCallbackTest, UploadSucceedsWhenAllInputsValid) {
+  // Given a snapshot of a process that crashed
+  TestProcessSnapshot snapshot;
+  InitializeProcessSnapshot(snapshot);
+
+  // And a valid set of annotation values
+  std::map<std::string, std::string> params = MakeValidParams();
+
+  // When we invoke our pre-upload callback to apply RUM crash processing logic
+  // prior to the HTTP upload of a minidump for this crash
+  HTTPHeaders extra_headers;
+  const bool ok = DatadogPreUploadCallback(snapshot, params, extra_headers);
+
+  // Then we get the OK to proceed with the upload
+  EXPECT_TRUE(ok);
+
+  // And two new events are added to that upload as annotations
+  EXPECT_EQ(params.count("dd.rum.view"), 1u);
+  EXPECT_EQ(params.count("dd.rum.error"), 1u);
+
+  // And all of our input values are omitted from the upload
+  EXPECT_EQ(params.count("dd.client_token"), 0u);
+  EXPECT_EQ(params.count("dd.tracking_consent"), 0u);
+  EXPECT_EQ(params.count("dd.config"), 0u);
+  EXPECT_EQ(params.count("dd.os"), 0u);
+  EXPECT_EQ(params.count("dd.device"), 0u);
+  EXPECT_EQ(params.count("dd.usr"), 0u);
+  EXPECT_EQ(params.count("dd.account"), 0u);
+  EXPECT_EQ(params.count("dd.rum.config"), 0u);
+  EXPECT_EQ(params.count("dd.rum.session"), 0u);
+  EXPECT_EQ(params.count("dd.rum.attributes"), 0u);
+  EXPECT_EQ(params.count("dd.rum.last_view"), 0u);
+
+  // And any existing, unrelated annotation values are kept as-is
+  EXPECT_EQ(params.at("other"), "value");
+
+  // And extra Datadog headers are included based on client token and config
+  EXPECT_EQ(extra_headers.at("DD-API-KEY"), "fake-client-token");
+  EXPECT_EQ(extra_headers.at("DD-EVP-ORIGIN"), "alto");
+  EXPECT_EQ(extra_headers.at("DD-EVP-ORIGIN-VERSION"), "1973.3.1");
+
+  // And both RUM events appear well-formed and contain sensible data based on
+  // our input values (note that unit tests in crash_processing fully validate
+  // this logic; we don't need exhaustive coverage here)
+  const std::string& view_json = params["dd.rum.view"];
+  const std::string& error_json = params["dd.rum.error"];
+  EXPECT_NE(view_json.find(R"("type":"view")"), std::string::npos);
+  EXPECT_NE(error_json.find(R"("type":"error")"), std::string::npos);
+  EXPECT_NE(error_json.find(R"("is_crash":true)"), std::string::npos);
+  EXPECT_NE(error_json.find("\"message\":\"Application crash: "
+#if BUILDFLAG(IS_WIN)
+                            "EXCEPTION_ACCESS_VIOLATION (0xC0000005)\""),
+#else
+                            "SIGSEGV (Segmentation fault)\""),
+#endif
+            std::string::npos);
+  EXPECT_NE(
+      view_json.find(
+          R"("application":{"id":"a991ca10-4004-4004-4004-beefbeefbeef")"),
+      std::string::npos);
+  EXPECT_NE(
+      error_json.find(
+          R"("application":{"id":"a991ca10-4004-4004-4004-beefbeefbeef")"),
+      std::string::npos);
+}
+
+TEST(DatadogPreUploadCallbackTest, UploadAbortedWhenNoClientToken) {
+  // Given a crash where no Datadog client token is available
+  TestProcessSnapshot snapshot;
+  InitializeProcessSnapshot(snapshot);
+  std::map<std::string, std::string> params = MakeValidParams();
+  params.erase("dd.client_token");
+
+  // When we attempt to process the crash
+  HTTPHeaders extra_headers;
+  const bool ok = DatadogPreUploadCallback(snapshot, params, extra_headers);
+
+  // Then the crash report is dropped, even though it had all required
+  // CrashContext
+  EXPECT_FALSE(ok);
+
+  // And all 'dd.*' annotations are stripped regardless, while the request
+  // remains otherwise unchanged
+  EXPECT_EQ(CountDatadogParameters(params), 0u);
+  EXPECT_EQ(params.at("other"), "value");
+  EXPECT_EQ(extra_headers.size(), 0u);
+}
+
+TEST(DatadogPreUploadCallbackTest, UploadAbortedWhenTrackingConsentNotGranted) {
+  // Given a crash where no the Datadog SDK did not have explicit tracking
+  // consent at the time of the crash
+  TestProcessSnapshot snapshot;
+  InitializeProcessSnapshot(snapshot);
+  std::map<std::string, std::string> params = MakeValidParams();
+  params["dd.tracking_consent"] = "not-granted";
+
+  // When we attempt to process the crash
+  HTTPHeaders extra_headers;
+  const bool ok = DatadogPreUploadCallback(snapshot, params, extra_headers);
+
+  // Then the crash report is dropped, even though it had all required
+  // CrashContext
+  EXPECT_FALSE(ok);
+
+  // And all 'dd.*' annotations are stripped regardless
+  EXPECT_EQ(CountDatadogParameters(params), 0u);
+  EXPECT_EQ(params.at("other"), "value");
+}
+
+TEST(DatadogPreUploadCallbackTest, UploadAbortedWhenTrackingConsentPending) {
+  // Given a crash where no the Datadog SDK did not have explicit tracking
+  // consent at the time of the crash
+  TestProcessSnapshot snapshot;
+  InitializeProcessSnapshot(snapshot);
+  std::map<std::string, std::string> params = MakeValidParams();
+  params["dd.tracking_consent"] = "pending";
+
+  // When we attempt to process the crash
+  HTTPHeaders extra_headers;
+  const bool ok = DatadogPreUploadCallback(snapshot, params, extra_headers);
+
+  // Then the crash report is dropped, even though it had all required
+  // CrashContext
+  EXPECT_FALSE(ok);
+
+  // And all 'dd.*' annotations are stripped regardless
+  EXPECT_EQ(CountDatadogParameters(params), 0u);
+  EXPECT_EQ(params.at("other"), "value");
+}
+
+TEST(DatadogPreUploadCallbackTest, UploadAbortedWhenTrackingConsentMissing) {
+  // Given a crash where the 'dd.tracking_consent' annotation is not set at all
+  TestProcessSnapshot snapshot;
+  InitializeProcessSnapshot(snapshot);
+  std::map<std::string, std::string> params = MakeValidParams();
+  params.erase("dd.tracking_consent");
+
+  // When we attempt to process the crash
+  HTTPHeaders extra_headers;
+  const bool ok = DatadogPreUploadCallback(snapshot, params, extra_headers);
+
+  // Then the crash report is dropped, because a missing tracking consent value
+  // is treated the same as 'pending' consent
+  EXPECT_FALSE(ok);
+
+  // And all 'dd.*' annotations are stripped regardless
+  EXPECT_EQ(CountDatadogParameters(params), 0u);
+  EXPECT_EQ(params.at("other"), "value");
+}
