+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include "handler/datadog_pre_upload_callback.h"
+
+#include "base/logging.h"
+#include "util/misc/time.h"
+
+#include "snapshot/exception_snapshot.h"
+
+#if WITH_DATADOG_CRASH_PROCESSING
+#include <cinttypes>
+#include <vector>
+
+#include "build/build_config.h"
+#include "datadog/impl/crash_processing/crash_context_annotations.hpp"
+#include "datadog/impl/crash_processing/crash_events.hpp"
+
+#if BUILDFLAG(IS_APPLE)
+#include <csignal>
+#include <mach/exception_types.h>
+#if defined(ARCH_CPU_X86_FAMILY)
+#include <mach/i386/exception.h>
+#endif
+#endif
+
+namespace crashpad {
+
+namespace {
+
+/**
+ * Returns a DiagnosticLogger that wraps the Crashpad handler's logging
+ * functionality (which directs output to stderr) in an interface that's usable
+ * by the Datadog SDK.
+ */
+datadog::impl::DiagnosticLogger MakeDiagnosticLogger(
+    datadog::DiagnosticLevel threshold) {
+  return datadog::impl::DiagnosticLogger{
+      [](const datadog::DiagnosticMessage& message) {
+        switch (message.level) {
+          case datadog::DiagnosticLevel::Debug:
+          case datadog::DiagnosticLevel::Status:
+            LOG(INFO) << message.text;
+            break;
+          case datadog::DiagnosticLevel::Warning:
+            LOG(WARNING) << message.text;
+            break;
+          case datadog::DiagnosticLevel::Error:
+            LOG(ERROR) << message.text;
+            break;
+        }
+      },
+      threshold};
+}
+
+/**
+ * Given a the basic details of a Crashpad minidump reflecting the state of a
+ * crashed process, returns a CrashDump struct that allows the Datadog SDK to
+ * read the basic details of the crash.
+ */
+datadog::impl::CrashDump MakeCrashDump(const ProcessSnapshot& snapshot) {
+  // Get the PID of the process that crashed. crashpad::ProcessID is
+  // platform-dependent and may be signed or unsigned, 32-bit or 64-bit.
+  // CrashDump expects uint64_t, so clamp at 0 if negative on platforms where
+  // PID is signed.
+  ProcessID crashpad_pid = snapshot.ProcessID();
+  if constexpr (std::is_signed_v<ProcessID>) {
+    if (crashpad_pid < 0) {
+      crashpad_pid = 0;
+    }
+  }
+  const uint64_t pid = static_cast<uint64_t>(crashpad_pid);
+
+  // Get the system time when the crash occurred (i.e. when the process snapshot
+  // was taken to create the minidump)
+  timeval snapshot_tv{};
+  snapshot.SnapshotTime(&snapshot_tv);
+  const int64_t ms = static_cast<int64_t>(snapshot_tv.tv_sec) * 1000 +
+                     static_cast<int64_t>(snapshot_tv.tv_usec) / 1000;
+  const uint64_t timestamp_ms = ms >= 0 ? static_cast<uint64_t>(ms) : 0;
+
+  // Obtain the fault_code, fault_address, and tid of the crashing thread from
+  // the exception info, if available
+  uint64_t fault_code = 0;
+  uint64_t fault_address = 0;
+  uint64_t tid = 0;
+  if (auto exc = snapshot.Exception()) {
+    fault_code = exc->Exception();
+    fault_address = exc->ExceptionAddress();
+    tid = exc->ThreadID();
+#if BUILDFLAG(IS_APPLE)
+    // On macOS, exc->Exception() returns the Mach exception type rather than a
+    // POSIX signal. We need a POSIX signal for FormatCrashReportErrorMessage(),
+    // so translate here.
+    //
+    // Two cases:
+    //
+    // 1. EXC_CRASH: the kernel wraps both software-signalled crashes (e.g.
+    //    raise(SIGSEGV)) and, on arm64, hardware faults in EXC_CRASH before
+    //    delivering them. The original POSIX signal is in bits 24-31 of
+    //    Codes()[1] (see ExcCrashRecoverOriginalException in Crashpad, and
+    //    XNU bsd/kern/kern_exit.c proc_prepareexit()).
+    //
+    // 2. Hardware exception without EXC_CRASH wrapper: on x86_64, hardware
+    //    faults (EXC_BAD_ACCESS etc.) may arrive directly. Map the Mach
+    //    exception type to its POSIX signal using the same table as XNU's
+    //    ux_exception() (bsd/kern/ux_exception.c).
+    const auto& codes = exc->Codes();
+    if (fault_code == EXC_CRASH) {
+      // EXC_CRASH wrapper: recover the original POSIX signal directly.
+      fault_code = codes.size() >= 2 ? (codes[1] >> 24) & 0xff : 0;
+    } else {
+      // No EXC_CRASH wrapper: map the Mach exception type to its POSIX signal.
+      // Source: XNU bsd/kern/ux_exception.c ux_exception().
+      // For EXC_BAD_ACCESS, XNU signals SIGBUS for EXC_I386_GPFLT (general
+      // protection fault) and SIGSEGV for all other subcodes. On arm64 this
+      // path is not normally reached (hardware faults are always wrapped in
+      // EXC_CRASH), but SIGSEGV is the correct fallback if it ever is.
+      switch (fault_code) {
+        case EXC_BAD_ACCESS:
+#if defined(ARCH_CPU_X86_FAMILY)
+          {
+            const uint64_t exc_code_0 =
+                codes.size() >= 1 ? codes[0] : 0;
+            fault_code = (exc_code_0 == EXC_I386_GPFLT) ? SIGBUS : SIGSEGV;
+          }
+#else
+          fault_code = SIGSEGV;
+#endif
+          break;
+        case EXC_BAD_INSTRUCTION:
+          fault_code = SIGILL;
+          break;
+        case EXC_ARITHMETIC:
+          fault_code = SIGFPE;
+          break;
+        case EXC_EMULATION:
+          fault_code = SIGEMT;
+          break;
+        case EXC_BREAKPOINT:
+          fault_code = SIGTRAP;
+          break;
+        default:
+          // Leave fault_code as the raw Mach exception type; it will produce
+          // an "Application crash: signal N" message, which is still useful.
+          break;
+      }
+    }
+#endif
+  }
+
+  // This basic data gives us the minimal set of data required to produce RUM
+  // Errors for this crash, while leaving `modules` and `stack` empty since they
+  // will need to be processed on the backend where debug symbols and unwind
+  // metadata are available
+  return datadog::impl::CrashDump{
+      fault_code,
+      fault_address,
+      0,  // fault_flags
+      pid,
+      tid,
+      timestamp_ms,
+      {},  // modules
+      {},  // stack
+  };
+}
+}  // namespace
+
+bool DatadogPreUploadCallback(const ProcessSnapshot& snapshot,
+                              std::map<std::string, std::string>& parameters,
+                              HTTPHeaders& extra_headers) {
+  // Construct a DiagosticLogger that wraps Crashpad's own log output
+  // functionality, so that diagnostic output related to crash processing will
+  // be routed to crashpad_handler's stderr
+  auto diagnostic_logger =
+      MakeDiagnosticLogger(datadog::DiagnosticLevel::Status);
+
+  // Parse a CrashContext struct from the annotation values which were
+  // originally populated by the SDK's Crashpad-based ICrashHandler
+  // implementation in the application process
+  const auto crash_context =
+      datadog::impl::ParseCrashContextFromAnnotations(parameters);
+
+  // Our intermediate annotation values (dd.tracking_consent, dd.config, etc.)
+  // only exist to give this handler process the necessary CrashContext data to
+  // make a RUM crash processing decision: now that we've parsed them, strip
+  // them from the `parameters` map so they won't be included in the HTTP
+  // upload, regardless of whether our CrashContext parsing of RUM processing
+  // logic succeeds
+  datadog::impl::RemoveCrashContextAnnotations(parameters);
+
+  // While the annotations we just parsed and removed represent the CrashContext
+  // data for this crash, a separate 'dd.client_token' value contains the client
+  // token used to upload data for the instrumented application: copy this value
+  // into our extra headers as DD-API-KEY, then remove it as well. If not found,
+  // abort the upload, since the minidump endpoint will reject the request.
+  const auto client_token_iter = parameters.find("dd.client_token");
+  if (client_token_iter == parameters.end()) {
+    diagnostic_logger.Error("Ignoring crash report: missing dd.client_token");
+    return false;
+  }
+  extra_headers["DD-API-KEY"] = client_token_iter->second;
+  parameters.erase(client_token_iter);
+
+  // Set additional headers which identify this request as originating from a
+  // particular Datadog SDK, based on the internally-configured 'source' and SDK
+  // version values parsed from CrashContext
+  extra_headers["DD-EVP-ORIGIN"] = crash_context.source;
+  extra_headers["DD-EVP-ORIGIN-VERSION"] = crash_context.sdk_version;
+
+  // Generate a random UUID to use as a unique request ID
+  crashpad::UUID request_id;
+  if (request_id.InitializeWithNew()) {
+    extra_headers["DD-REQUEST-ID"] = request_id.ToString();
+  }
+
+  // The ProcessSnapshot reflects the state of the process at the moment of
+  // the crash: initialize a CrashDump struct that carries the essential details
+  // required to produce events for this crash (crash timestamp, exception code
+  // for use in formatting error.message, etc.)
+  const auto crash_dump = MakeCrashDump(snapshot);
+
+  // Get the current system time, converting to an int64 count of nanoseconds
+  // since the Unix epoch: this is used to evaluate the 4-hour cutoff on view
+  // updates; it need not be precisely synchronized to the same time basis used
+  // by the SDK
+  timeval tv;
+#if BUILDFLAG(IS_WIN)
+  crashpad::GetTimeOfDay(&tv);
+#else
+  gettimeofday(&tv, nullptr);
+#endif
+  const datadog::Timestamp current_time{
+      datadog::Duration(static_cast<int64_t>(tv.tv_sec) * 1'000'000'000 +
+                        static_cast<int64_t>(tv.tv_usec) * 1'000)};
+
+  // The RUM application ID is typically encoded in annotations, but our crash
+  // processing code allows a fallback to be specified (from current SDK config)
+  // in case the crash uses an older data format or occurred before initial RUM
+  // config could be persisted. This fallback UUID only makes sense in the
+  // in-process case (we don't have any way of knowing the SDK's own RumConfig
+  // details here), so we just rely on the annotation and fall back to zero.
+  const datadog::UUID fallback_application_id = datadog::UUID::Zero;
+
+  // Crash processing code expects a reusable buffer to minimize allocations
+  // when encoding events to JSON: this isn't really useful for the Crashpad
+  // handler (which will store those events as `std::string` anyway), but it's
+  // useful for the in-process implementation
+  std::vector<uint8_t> encode_buffer;
+
+  // Run our main RUM logic from the SDK's impl/crash_processing module,
+  // deciding how we will handle a crash described by this CrashDump and
+  // CrashContext. If any RUM View or Error event is produced, it will be added
+  // to the parameters included in the upload as multipart/form-data fields, and
+  // a return value of true will cause the handler to proceed with the upload.
+  // If the crash can not be handled or is deliberately dropped, a return value
+  // of false causes the handler to permanently abort this upload.
+  return datadog::impl::ProduceRumEventsForCrash(
+      crash_dump,
+      crash_context,
+      diagnostic_logger,
+      current_time,
+      fallback_application_id,
+      encode_buffer,
+      [&parameters](datadog::impl::CrashEventType type,
+                    std::string_view value) -> bool {
+        switch (type) {
+          case datadog::impl::CrashEventType::View:
+            parameters["dd.rum.view"] = std::string(value);
+            return true;
+          case datadog::impl::CrashEventType::Error:
+            parameters["dd.rum.error"] = std::string(value);
+            return true;
+        }
+        return false;
+      });
+}
+
+}  // namespace crashpad
+
+#else
+
+// If WITH_DATADOG_CRASH_PROCESSING is disabled, our Crashpad build wasn't
+// configured with a path to dd-sdk-cpp source, despite having
+// WITH_DATADOG_UPLOAD_EXTENSIONS enabled. This is likely an error - the
+// developer didn't properly configure the build via dd-sdk-cpp's
+// bootstrap-crashpad script - and we should signal that fact clearly while
+// refusing to build.
+#error \
+    "WITH_DATADOG_CRASH_PROCESSING is not defined: no dd-sdk-cpp source path was provided to GN via 'dd_sdk_cpp_dir'. When compiled with Datadog modifications, the crashpad build should be run from dd-sdk-cpp by setting DD_CRASH_MODE=crashpad and DD_CRASHPAD_LOCAL_CLONE=<path-to-crashpad-source>."
+
+#endif
