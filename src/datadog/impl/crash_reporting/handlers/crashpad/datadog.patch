+
+namespace crashpad {
+
+//! \brief Pre-upload callback implementing Datadog-specific crash handling.
+//!
+//! This function is intended to be passed as the `pre_upload_callback`
+//! argument to `CrashReportUploadThread`. It is invoked on the upload thread
+//! for each crash report before the HTTP request is assembled.
+//!
+//! \param[in,out] parameters The annotation-derived form-field map for the
+//!     crash report. The callback may read, modify, or erase entries.
+//!
+//! \return `true` to proceed with the upload, `false` to suppress it.
+bool DatadogPreUploadCallback(const ProcessSnapshot& snapshot,
+                              std::map<std::string, std::string>& parameters,
+                              HTTPHeaders& extra_headers);
+
