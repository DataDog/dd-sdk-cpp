+#ifndef CRASHPAD_HANDLER_DATADOG_PRE_UPLOAD_CALLBACK_H_
+#define CRASHPAD_HANDLER_DATADOG_PRE_UPLOAD_CALLBACK_H_
+
+#include <map>
