index 00000000..1fde4937
--- /dev/null
+++ b/handler/crash_report_upload_thread_test.cc
@@ -0,0 +1,229 @@
+// Copyright 2026 Datadog, Inc.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
