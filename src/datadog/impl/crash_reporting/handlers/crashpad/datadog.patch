+namespace crashpad::test {
+namespace {
+
+#if WITH_DATADOG_UPLOAD_EXTENSIONS
+
+// Writes a minimal but valid minidump containing an annotation key/value pair
+// into a new report and finalizes it in |db|. On success, |uuid| is set to
+// the new report's UUID and true is returned.
+bool WriteMinidumpReport(CrashReportDatabase* db,
+                         const std::string& annotation_key,
+                         const std::string& annotation_value,
+                         UUID* uuid) {
+  std::unique_ptr<CrashReportDatabase::NewReport> new_report;
+  if (db->PrepareNewCrashReport(&new_report) != CrashReportDatabase::kNoError) {
+    return false;
+  }
+
+  TestProcessSnapshot process_snapshot;
+  process_snapshot.SetAnnotationsSimpleMap(
+      {{annotation_key, annotation_value}});
+
+  auto system_snapshot = std::make_unique<TestSystemSnapshot>();
+  system_snapshot->SetCPUArchitecture(kCPUArchitectureARM64);
+  system_snapshot->SetOperatingSystem(SystemSnapshot::kOperatingSystemMacOSX);
+  process_snapshot.SetSystem(std::move(system_snapshot));
+
+  MinidumpFileWriter minidump_writer;
+  minidump_writer.InitializeFromSnapshot(&process_snapshot);
+  if (!minidump_writer.WriteEverything(new_report->Writer())) {
+    return false;
+  }
+
+  return db->FinishedWritingCrashReport(std::move(new_report), uuid) ==
+         CrashReportDatabase::kNoError;
+}
+
+// Returns CrashReportUploadThread::Options suitable for tests: no
+// rate-limiting, no URL-based client identification, no gzip, no background
+// scan.
+CrashReportUploadThread::Options TestOptions() {
+  CrashReportUploadThread::Options opts;
+  opts.identify_client_via_url = false;
+  opts.rate_limit = false;
+  opts.upload_gzip = false;
+  opts.watch_pending_reports = false;
+  return opts;
+}
+
+// Tests that the pre-upload callback is invoked exactly once and receives the
+// annotations that were written into the minidump.
+TEST(CrashReportUploadThreadTest, PreUploadCallbackInvoked) {
+  test::ScopedTempDir temp_dir;
+  auto db = CrashReportDatabase::Initialize(temp_dir.path());
+  ASSERT_TRUE(db);
+  ASSERT_TRUE(db->GetSettings()->SetUploadsEnabled(true));
+
+  static constexpr char kKey[] = "dd_test_key";
+  static constexpr char kValue[] = "dd_test_value";
+
+  UUID uuid;
+  ASSERT_TRUE(WriteMinidumpReport(db.get(), kKey, kValue, &uuid));
+
+  // Signalled by pre_upload_callback when it fires on the upload thread.
+  Semaphore callback_fired(0);
+  std::map<std::string, std::string> received_parameters;
+
+  // Signalled by the ProcessPendingReportsObservationCallback when the upload
+  // thread finishes processing the cycle containing our report. Waiting on
+  // this before Stop() ensures received_parameters has been written and the
+  // report has left the pending state, without depending on how quickly the
+  // HTTP transport fails.
+  Semaphore cycle_done(0);
+
+  CrashReportUploadThread thread(
+      db.get(),
+      "http://localhost/",
+      TestOptions(),
+      /*callback=*/[&]() { cycle_done.Signal(); },
+      /*pre_upload_callback=*/
+      [&](const ProcessSnapshot&,
+          std::map<std::string, std::string>& parameters,
+          HTTPHeaders&) -> bool {
+        received_parameters = parameters;
+        callback_fired.Signal();
+        return true;
+      });
+
+  thread.Start();
+  thread.ReportPending(uuid);
+
+  // The pre-upload callback fires before the HTTP attempt, so it should arrive
+  // well within 5 seconds.
+  EXPECT_TRUE(callback_fired.TimedWait(5.0));
+
+  // Wait for the full cycle to complete before stopping the thread. This
+  // provides the happens-before edge for reading received_parameters and
+  // avoids Stop() racing the in-flight upload attempt.
+  EXPECT_TRUE(cycle_done.TimedWait(65.0));
+
+  thread.Stop();
+
+  ASSERT_TRUE(received_parameters.count(kKey));
+  EXPECT_EQ(received_parameters.at(kKey), kValue);
+}
+
+// Tests that passing an empty PreUploadCallback does not crash and that the
+// report is still processed normally.
+TEST(CrashReportUploadThreadTest, NoCallbackWhenEmpty) {
+  test::ScopedTempDir temp_dir;
+  auto db = CrashReportDatabase::Initialize(temp_dir.path());
+  ASSERT_TRUE(db);
+  ASSERT_TRUE(db->GetSettings()->SetUploadsEnabled(true));
+
+  UUID uuid;
+  ASSERT_TRUE(
+      WriteMinidumpReport(db.get(), "irrelevant_key", "irrelevant_value", &uuid));
+
+  // Signalled when the upload thread finishes the cycle containing our report.
+  // Using the ProcessPendingReportsObservationCallback as the synchronization
+  // point avoids any dependency on how quickly (or slowly) the HTTP transport
+  // fails on a given platform.
+  Semaphore cycle_done(0);
+
+  // Construct without a pre_upload_callback -- the default-constructed empty
+  // std::function should not be called.
+  CrashReportUploadThread thread(
+      db.get(),
+      "http://localhost/",
+      TestOptions(),
+      /*callback=*/[&]() { cycle_done.Signal(); });
+
+  thread.Start();
+  thread.ReportPending(uuid);
+
+  // Wait for the cycle to complete (generous bound to accommodate the HTTP
+  // transport timeout on slow or loaded machines).
+  EXPECT_TRUE(cycle_done.TimedWait(65.0));
+
+  thread.Stop();
+
+  // The report must have been moved out of the pending state.
+  std::vector<CrashReportDatabase::Report> pending;
+  EXPECT_EQ(db->GetPendingReports(&pending), CrashReportDatabase::kNoError);
+  EXPECT_TRUE(pending.empty());
+}
+
+// Verifies that when a pre-upload callback returns false, we suppress the
+// upload and move the report to the completed (skipped) state.
+TEST(CrashReportUploadThreadTest, UploadSuppressedWhenCallbackReturnsFalse) {
+  test::ScopedTempDir temp_dir;
+  auto db = CrashReportDatabase::Initialize(temp_dir.path());
+  ASSERT_TRUE(db);
+  ASSERT_TRUE(db->GetSettings()->SetUploadsEnabled(true));
+
+  UUID uuid;
+  ASSERT_TRUE(
+      WriteMinidumpReport(db.get(), "irrelevant_key", "irrelevant_value", &uuid));
+
+  // Suppression happens entirely inside UploadReport() before any HTTP
+  // attempt, so the cycle completes quickly regardless of platform. The
+  // cycle_done semaphore therefore provides both the "callback was invoked"
+  // assertion and the happens-before edge for the completed-list check.
+  Semaphore cycle_done(0);
+
+  CrashReportUploadThread thread(
+      db.get(),
+      "http://localhost/",
+      TestOptions(),
+      /*callback=*/[&]() { cycle_done.Signal(); },
+      /*pre_upload_callback=*/
+      [&](const ProcessSnapshot&,
+          std::map<std::string, std::string>&,
+          HTTPHeaders&) -> bool {
+        return false;
+      });
+
+  thread.Start();
+  thread.ReportPending(uuid);
+
+  EXPECT_TRUE(cycle_done.TimedWait(5.0));
+
+  thread.Stop();
+
+  // The report must appear in the completed list and must not be marked as
+  // uploaded -- it was suppressed, not successfully sent.
+  std::vector<CrashReportDatabase::Report> completed;
+  ASSERT_EQ(db->GetCompletedReports(&completed), CrashReportDatabase::kNoError);
+  auto it = std::find_if(completed.begin(), completed.end(),
+                         [&](const CrashReportDatabase::Report& r) {
+                           return r.uuid == uuid;
+                         });
+  ASSERT_NE(it, completed.end());
+  EXPECT_FALSE(it->uploaded);
+}
+
+#endif  // WITH_DATADOG_UPLOAD_EXTENSIONS
+
+}  // namespace
+}  // namespace crashpad::test
